[Unit]
Description=Aneta Research Go Backend & AI Agent API Service
After=network.target

[Service]
Type=simple
User=apps
WorkingDirectory=/var/www/report
Environment="PORT=8088"
Environment="PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin:/home/apps/.local/bin"
ExecStart=/var/www/report/aneta-api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
